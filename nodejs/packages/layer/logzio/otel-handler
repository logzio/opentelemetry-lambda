#!/bin/bash
# Logz.io Lambda layer for Node.js: upstream scripts/otel-handler plus the Logz.io hooks and defaults.
set -ef -o pipefail

# Logz.io hooks (route naming, async trace propagation, cold starts, event sources, console logs),
# loaded before the OpenTelemetry SDK starts.
export NODE_OPTIONS="${NODE_OPTIONS} --require /opt/nodejs/logzio-otel-hooks.cjs --import /opt/init.mjs"

if [[ $OTEL_RESOURCE_ATTRIBUTES != *"service.name="* ]]; then
  if [[ -n "$OTEL_RESOURCE_ATTRIBUTES" ]]; then
    export OTEL_RESOURCE_ATTRIBUTES="service.name=${AWS_LAMBDA_FUNCTION_NAME},${OTEL_RESOURCE_ATTRIBUTES}"
  else
    export OTEL_RESOURCE_ATTRIBUTES="service.name=${AWS_LAMBDA_FUNCTION_NAME}"
  fi
fi

if [[ -z "$OTEL_PROPAGATORS" ]]; then
  export OTEL_PROPAGATORS="tracecontext,baggage,xray"
fi

# Logz.io defaults: trace fetch() and common clients; send traces and console logs, no SDK metrics.
export OTEL_NODE_ENABLED_INSTRUMENTATIONS="${OTEL_NODE_ENABLED_INSTRUMENTATIONS:-http,undici,dns,net,pg,mysql,mysql2,redis,ioredis,mongodb,express,graphql}"
export OTEL_TRACES_EXPORTER="${OTEL_TRACES_EXPORTER:-otlp}"
export OTEL_LOGS_EXPORTER="${OTEL_LOGS_EXPORTER:-otlp}"
export OTEL_METRICS_EXPORTER="${OTEL_METRICS_EXPORTER:-none}"

exec "$@"
